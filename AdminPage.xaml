<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BTSS.IAR.Kiosk.AdminPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Admin"
    Padding="12">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">

        <!-- Action buttons (moved to top) -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Button Text="Start" Clicked="OnStartClicked" />
            <Button Text="Stop" Clicked="OnStopClicked" />
            <Button Text="Calls" Clicked="OnCallsClicked" />
            <Button Text="Agencies" Clicked="OnAgenciesClicked" />
            <Button Text="Clear Creds" Clicked="OnClearCredsClicked" />
            <Button Text="Reset Web Session" Clicked="OnResetWebSessionClicked" />
            <Button Text="Save Printer" Clicked="OnSavePrinterClicked" />
        </HorizontalStackLayout>

        <!-- Tabs -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
            <RadioButton
                Grid.Column="0"
                Content="General"
                GroupName="AdminTabs"
                IsChecked="True"
                CheckedChanged="OnTabCheckedChanged"
                Value="general" />

            <RadioButton
                Grid.Column="1"
                Content="Display"
                GroupName="AdminTabs"
                CheckedChanged="OnTabCheckedChanged"
                Value="display" />

            <RadioButton
                Grid.Column="2"
                Content="Email"
                GroupName="AdminTabs"
                CheckedChanged="OnTabCheckedChanged"
                Value="email" />

            <RadioButton
                Grid.Column="3"
                Content="Printer"
                GroupName="AdminTabs"
                CheckedChanged="OnTabCheckedChanged"
                Value="printer" />
        </Grid>

        <!-- Tab content -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="16">

                <!-- General tab -->
                <VerticalStackLayout x:Name="GeneralPanel" Spacing="12">
                    <Label Text="Startup" FontAttributes="Bold" FontSize="18" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Auto start at Windows login" VerticalOptions="Center" />
                        <Switch Grid.Row="0" Grid.Column="1" x:Name="AutoStartSwitch" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Start display on startup" VerticalOptions="Center" />
                        <Switch Grid.Row="1" Grid.Column="1" x:Name="StartDisplayOnStartupSwitch" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Start minimized" VerticalOptions="Center" />
                        <Switch Grid.Row="2" Grid.Column="1" x:Name="StartMinimizedSwitch" />
                    </Grid>

                    <Label Text="Kiosk URL" FontAttributes="Bold" FontSize="18" />
                    <Entry x:Name="UrlEntry" Placeholder="https://..." />

                    <Label Text="Portal Credentials" FontAttributes="Bold" FontSize="18" />
                    <Entry x:Name="AgencyEntry" Placeholder="Agency" />
                    <Entry x:Name="UserEntry" Placeholder="Username" />
                    <Entry x:Name="PassEntry" Placeholder="Password" IsPassword="True" />
                </VerticalStackLayout>

                <!-- Display tab -->
                <VerticalStackLayout x:Name="DisplayPanel" Spacing="12" IsVisible="False">
                    <Label Text="Display" FontAttributes="Bold" FontSize="18" />
                    <Label Text="Monitor" />
                    <Picker x:Name="MonitorPicker" Title="Select monitor" />
                </VerticalStackLayout>

                <!-- Email tab -->
                <VerticalStackLayout x:Name="EmailPanel" Spacing="12" IsVisible="False">
                    <Label Text="Processing" FontAttributes="Bold" FontSize="18" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Pause email/IAR checking" VerticalOptions="Center" />
                        <Switch Grid.Row="0" Grid.Column="1" x:Name="PauseCheckingSwitch" />
                    </Grid>
                    <Label FontSize="12" Opacity="0.8" Text="When paused, the kiosk will not poll email or the IAR API until resumed." />
                    <Label Text="Mode" />
                    <Picker x:Name="ProcessingModePicker" Title="Select mode" />

                    <!-- Email mode fields -->
                    <VerticalStackLayout x:Name="EmailFields" Spacing="10">
                        <Label Text="Dispatch Email" FontAttributes="Bold" FontSize="16" />
                        <Entry x:Name="GmailAddressEntry" Placeholder="Email address" Keyboard="Email" />
                        <Entry x:Name="GmailAppPasswordEntry" Placeholder="App password" IsPassword="True" />
                    </VerticalStackLayout>

                    <!-- IAR API mode fields -->
                    <VerticalStackLayout x:Name="IarApiFields" Spacing="10" IsVisible="False">
                        <Label Text="IAR API" FontAttributes="Bold" FontSize="16" />
                        <Entry x:Name="IarApiBaseUrlEntry" Placeholder="Base URL (e.g. http://server:5080)" />
                        <Entry x:Name="IarApiAgencyIdEntry" Placeholder="Agency Identifier (numeric)" Keyboard="Numeric" />
                        <Entry x:Name="IarApiClientIdEntry" Placeholder="Client Id" />
                        <Entry x:Name="IarApiClientSecretEntry" Placeholder="Client Secret" IsPassword="True" />
                        <Label FontSize="12" Opacity="0.8" Text="In IAR API mode, the kiosk polls every minute for newly closed calls and prints them." />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Printer tab -->
                <VerticalStackLayout x:Name="PrinterPanel" Spacing="12" IsVisible="False">
                    <Label Text="Printer" FontAttributes="Bold" FontSize="18" />
                    <Picker x:Name="PrinterPicker" Title="Select printer" />
                    <Label FontSize="12" Opacity="0.8"
                           Text="Use the Save Printer button at the top after selecting a printer." />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
