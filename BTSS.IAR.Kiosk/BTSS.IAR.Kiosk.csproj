<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>BTSS.IAR.Kiosk</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>

    <ApplicationTitle>BTSS.IAR.Kiosk</ApplicationTitle>
    <ApplicationId>com.companyname.btss.iar.kiosk</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <CreateMSIXPackage>False</CreateMSIXPackage>
    <AssemblyTitle>Kiosk Display Shell</AssemblyTitle>
    <AssemblyName>BTSS Kiosk Display</AssemblyName>
    <Title>BTSS Display</Title>
  </PropertyGroup>

	
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AdminPage.xaml.cs" />
    <Compile Remove="AgencySetupPage.xaml.cs" />
    <Compile Remove="CallsPage.xaml.cs" />
    <Compile Remove="KorzhQueryPage.xaml.cs" />
    <Compile Remove="KorzhReportsPage.xaml.cs" />
    <Compile Remove="MainPage.xaml.cs" />
    <MauiXaml Remove="AdminPage.xaml" />
    <MauiXaml Remove="AgencySetupPage.xaml" />
    <MauiXaml Remove="CallsPage.xaml" />
    <MauiXaml Remove="KorzhQueryPage.xaml" />
    <MauiXaml Remove="KorzhReportsPage.xaml" />
    <MauiXaml Remove="MainPage.xaml" />
  </ItemGroup>


  <ItemGroup>
    <Content Include="Resources\AppIcon\Btss.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Resources\AppIcon\Btss.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="14.0.1" />
    <PackageReference Include="CommunityToolkit.Maui.Core" Version="14.0.1" />
    <PackageReference Include="MailKit" Version="4.15.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.3" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.41" />
    <PackageReference Include="Microsoft.Maui.Core" Version="10.0.41" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.3" />
    <PackageReference Include="H.NotifyIcon.Maui" Version="2.4.1" Condition="'$(TargetFramework)'=='net10.0-windows10.0.19041.0'" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="DisplayPage.xaml.cs">
      <DependentUpon>DisplayPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="BootstrapPage.xaml.cs">
      <DependentUpon>BootstrapPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <ProjectReference Include="..\BTSS.IAR.Record\BTSS.IAR.Record.csproj" />
  </ItemGroup>
</Project>
