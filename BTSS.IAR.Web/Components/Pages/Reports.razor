@page "/reports"
@inject HttpClient Http

<PageTitle>Reports</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="8">
            <RadzenText TextStyle="TextStyle.DisplayH5">Reports</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">Incidents, units, timelines, comments, and diagnostics subject areas with agency filters applied automatically.</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                <RadzenButton Text="Saved reports" Path="/reports/saved" Icon="bookmark" />
                <RadzenButton Text="Designer" Path="/reports/designer" Icon="edit_note" ButtonStyle="ButtonStyle.Secondary" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard>
        @if (model is null)
        {
            <RadzenText>Loading...</RadzenText>
        }
        else
        {
            <RadzenText TextStyle="TextStyle.Subtitle1">Active agency: @model.AgencyName</RadzenText>
            <RadzenRow Gap="1rem">
                @foreach (var area in model.SubjectAreas)
                {
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                        <RadzenCard Variant="Variant.Outlined">
                            <RadzenStack Gap="0.5rem">
                                <RadzenText TextStyle="TextStyle.H6">@area.Name</RadzenText>
                                <RadzenText>@area.Description</RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption">Fields: @string.Join(", ", area.Fields.Select(x => x.Label))</RadzenText>
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                }
            </RadzenRow>
        }
    </RadzenCard>
</RadzenStack>

@code {
    private ReportingModelDto? model;
    protected override async Task OnInitializedAsync() => model = await Http.GetFromJsonAsync<ReportingModelDto>("/api/reporting/model");
}
