@page "/login"
@attribute [AllowAnonymous]
@inject BTSS.IAR.Web.Services.BrowserAuthClient AuthClient
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<RadzenRow JustifyContent="JustifyContent.Center" class="rz-mt-12">
    <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.DisplayH5">BTSS Login</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1">Shared identity for BTSS.Web and kiosk admin access.</RadzenText>

                <RadzenTextBox @bind-Value="model.UserName" Name="username" Placeholder="Username" Style="width:100%" />
                <RadzenPassword @bind-Value="model.Password" Name="password" Placeholder="Password" Style="width:100%" />
                <RadzenCheckBox @bind-Value="rememberMe" /> <RadzenText>Remember me</RadzenText>
                <RadzenDropDown TValue="int?" Data="agencies" TextProperty="AgencyName" ValueProperty="AgencyId" @bind-Value="model.AgencyId" Placeholder="Agency context (optional)" Style="width:100%" />

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger">@error</RadzenAlert>
                }

                <RadzenButton Text="Sign in" Click="SignInAsync" ButtonStyle="ButtonStyle.Primary" />
                <RadzenText TextStyle="TextStyle.Caption">Default bootstrap admin: superadmin / ChangeMe123!</RadzenText>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

@code {
    private HumanLoginRequest model = new(null, null, null);
    private string? error;
    private bool rememberMe = true;
    private AgencyMembershipDto[] agencies = Array.Empty<AgencyMembershipDto>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var me = await AuthClient.GetCurrentUserAsync();
        if (me is not null)
        {
            Navigation.NavigateTo("/", true);
        }
    }

    private async Task SignInAsync()
    {
        error = null;

        var result = await AuthClient.LoginAsync(model);
        if (result.Success)
        {
            var current = result.User;
            agencies = current?.Agencies ?? Array.Empty<AgencyMembershipDto>();

            if ((current?.Agencies?.Length ?? 0) > 1 && current?.ActiveAgencyId is null)
                Navigation.NavigateTo("/agency-chooser", true);
            else
                Navigation.NavigateTo("/", true);

            return;
        }

        error = result.StatusCode == 401
            ? "Invalid username or password."
            : $"Login failed: {result.StatusCode}";
    }
}