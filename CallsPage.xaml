<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BTSS.IAR.Kiosk.CallsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Calls">

    <Grid Padding="12" RowDefinitions="Auto,Auto,*" RowSpacing="10">

        <Label Grid.Row="0" Text="IAR Calls" FontAttributes="Bold" FontSize="18" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
            <DatePicker x:Name="StartDatePicker" Grid.Row="0" Grid.Column="0" />
            <DatePicker x:Name="EndDatePicker" Grid.Row="0" Grid.Column="1" />
            <Entry x:Name="CallTypeEntry" Grid.Row="0" Grid.Column="2" Placeholder="Call type (optional)" />
            <Button Grid.Row="0" Grid.Column="3" Text="Search" Clicked="OnSearchClicked" />

            <Label Grid.Row="1" Grid.ColumnSpan="4" FontSize="12" Opacity="0.8"
                   Text="Search by date range + optional call type. Uses AgencyId from Admin settings." />
        </Grid>

        <CollectionView Grid.Row="2" x:Name="CallsView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,0,0,10" Padding="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding CallIdentifier}" FontAttributes="Bold" />
                            <Label Text="{Binding Type}" />
                            <Label Text="{Binding Address}" />
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="{Binding Closed, StringFormat='Closed: {0}'}" />
                                <Label Text="{Binding UpdatedAt, StringFormat='Updated: {0:G}'}" />
                            </HorizontalStackLayout>
                            <Button Text="Print" Clicked="OnPrintClicked" CommandParameter="{Binding CallIdentifier}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
